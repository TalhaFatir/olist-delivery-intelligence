Order Count =
COUNTROWS(Orders)

Eligible Deliveries =
CALCULATE(COUNTROWS(Orders), Orders[eligible] = 1)

Late Deliveries =
CALCULATE([Eligible Deliveries], Orders[late] = 1)

On Time Rate =
DIVIDE([Eligible Deliveries] - [Late Deliveries], [Eligible Deliveries])

Late Rate =
DIVIDE([Late Deliveries], [Eligible Deliveries])

Excluded Orders =
CALCULATE(COUNTROWS(Orders), Orders[eligible] = 0)

Mean Delivery Days =
CALCULATE(AVERAGE(Orders[delivery_days]), Orders[eligible] = 1)

P90 Delivery Days =
VAR T = FILTER(Orders, Orders[eligible] = 1 && NOT ISBLANK(Orders[delivery_days])) VAR N = COUNTROWS(T) RETURN IF(N > 0, MAXX(TOPN(ROUNDUP(N * 0.9, 0), T, Orders[delivery_days], ASC), Orders[delivery_days]))

Reviewed Deliveries =
CALCULATE([Eligible Deliveries], NOT ISBLANK(Orders[review_score]))

Low Reviews =
CALCULATE([Reviewed Deliveries], Orders[review_score] IN {1, 2})

Low Review Rate =
DIVIDE([Low Reviews], [Reviewed Deliveries])

Mean Review Score =
CALCULATE(AVERAGE(Orders[review_score]), Orders[eligible] = 1)

Item Value BRL =
SUM(Orders[item_cents]) / 100

Freight Charged BRL =
SUM(Orders[freight_cents]) / 100

Seller Eligible =
IF(SELECTEDVALUE(Orders[seller]) <> "Multiple sellers" && SELECTEDVALUE(Orders[seller]) <> "No seller" && HASONEVALUE(Orders[seller]) && [Eligible Deliveries] >= 100, [Eligible Deliveries])

Seller Late =
IF(SELECTEDVALUE(Orders[seller]) <> "Multiple sellers" && SELECTEDVALUE(Orders[seller]) <> "No seller" && HASONEVALUE(Orders[seller]) && [Eligible Deliveries] >= 100, [Late Deliveries])

Seller Late Rate =
IF(SELECTEDVALUE(Orders[seller]) <> "Multiple sellers" && SELECTEDVALUE(Orders[seller]) <> "No seller" && HASONEVALUE(Orders[seller]) && [Eligible Deliveries] >= 100, [Late Rate])

Seller Mean Days =
IF(SELECTEDVALUE(Orders[seller]) <> "Multiple sellers" && SELECTEDVALUE(Orders[seller]) <> "No seller" && HASONEVALUE(Orders[seller]) && [Eligible Deliveries] >= 100, [Mean Delivery Days])

Report Title =
"OLIST / Delivery Intelligence"

Source Note =
"Talha Fatir | Public Olist data | Brazil, 2016-2018 | CC BY-NC-SA 4.0"

Delivery Rule =
"Late = arrival calendar date after promise; valid delivered orders only."

Review Rule =
"Latest answered review per order; missing reviews excluded. Association, not causation."

Seller Rule =
"Single-seller orders only; at least 100 eligible deliveries in selection."

Money Rule =
"Item value is GMV, not revenue. Freight charged is not verified carrier cost."

Scope Rule =
"Historical Brazil extract; partial edge months. No current Canadian market claims."